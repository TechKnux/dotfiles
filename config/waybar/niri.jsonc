// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
   // "position": "top", // Waybar position (top|bottom|left|right)
    "height": 36, // Waybar height (to be removed for auto height)
    "spacing": 2, 
    "include":[
        "./modules/groups.jsonc",
        "./modules/connections.jsonc",
        "./modules/audio.jsonc",
        "./modules/clock.jsonc",
        "./modules/weather.jsonc",
        "./modules/audio.jsonc",
        "./modules/tray-notif.jsonc",
        "./modules/language.jsonc",
        "./modules/workspace.jsonc",
        "./modules/system.jsonc",
        "./modules/battery.jsonc",
        "./modules/storage.jsonc",
        "./modules/stasis.jsonc"
    ],
    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "custom/weather",
        "backlight",
        "group/storage",
        "group/system",
        "group/audio",
        "group/connections",
        "battery",
        "niri/language",
        "group/tray-group",
        "clock",
        "custom/stasis"
    ],

    // Modules configuration
     
    "niri/window":{
        "separate-outputs": true,
        "icon": true,
        "max-length": 50,
        "rewrite": {
            "(.*) - Zen Browser": "zen",
            "^$": "Niri"
        }
    },
              
    "backlight": {
       /* "device": "/dev/i2c-0",*/
        "format": " {percent}%"
       /* "format-icons": ["", "", "", "", "", "", "", "", ""]*/
    }
}  
