{

	"custom/stasis": {
  		"exec": "stasis info --json",
  		"format": "{icon}",
  		"format-icons": {
    		"idle_active": "",
    		"idle_waiting": "",
    		"idle_inhibited": "",
    		"manually_inhibited": "",
    		"not_running": "󰒲"
  		},
  	"tooltip": true,
  	"on-click": "stasis toggle-inhibit",
  	"interval": 2,
  	"restart-interval": 2,
  	"return-type": "json"
	}

}
