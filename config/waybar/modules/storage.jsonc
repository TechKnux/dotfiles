{
  "disk": {
    "tooltip": false,
    "interval": 3600,
    "path": "/",
    "format": "󱙋 <span size='12pt'>{used}</span>",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "memory": {
    "tooltip": true,
    "interval": 5,
    "format": " <span size='12pt'>{used}</span>",
    "states": {
      "warning": 75,
      "critical": 85
    }
  }
}
