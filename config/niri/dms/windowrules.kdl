// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^goofcord$"
    open-on-output "eDP-1"
}

// @id=wr_1781042374493816702 @name=google-chrome
window-rule {
    match app-id="^google-chrome$"
    open-on-output "eDP-1"
}

// @id=dms_rule_4 @name=^zen$
window-rule {
    match app-id="^zen$"
    open-on-output "HDMI-A-2"
}

// @id=wr_1781041005070585898 @name=steam
window-rule {
    match app-id="^steam$"
    open-maximized true
    open-on-output "HDMI-A-2"
}

// @id=wr_1781041151267967124 @name=zen
window-rule {
    match app-id="^zen$" title="Picture-in-Picture"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="io.ente.auth$"
    block-out-from "screen-capture"
}

// @id=dms_rule_2 @name=
window-rule {
    match is-window-cast-target=true
    focus-ring { active-color "#f38ba8"; }
}

// @id=wr_1781041416432936910 @name=steam
window-rule {
    match app-id="^steam$" title="Configurações"
    open-floating true
}

// @id=wr_1781041467156838738 @name=steam
window-rule {
    match app-id="^steam$" title="Lista de amigos"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

// @id=wr_1781041595174310353 @name=steam
window-rule {
    match app-id="^steam$" title="Ofertas especiais"
    open-floating true
}

// @id=dms_rule_10 @name=
window-rule {
    match app-id="^foot$"
}

// @id=wr_1781048468021805668 @name=zen
window-rule {
    match app-id="^zen$" title="Extensão: (Bitwarden Gerenciador de Senhas)"
    open-floating true
}
